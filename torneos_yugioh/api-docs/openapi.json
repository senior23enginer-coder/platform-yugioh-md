              }
            }
          },
          "503": {
            "description": "Operación no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "saveCombo",
        "summary": "Crear o actualizar combo",
        "tags": [
          "Combos"
        ],
        "description": "El ID pertenece al documento; revision=0 crea, una revisión vigente actualiza. Usa el inventario_sha256 de la consulta anterior. Incluye grafo, pasos y fuentes con historial nativo.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "403": {
            "description": "Sesión o permisos inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Versión o inventario cambió.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Datos no válidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Operación no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComboSave"
              }
            }
          }
        },
        "security": [
          {
            "sessionCsrf": []
          }
        ]
      }
    },
