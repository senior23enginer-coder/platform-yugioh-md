    "/deck-data/status": {
      "get": {
        "operationId": "getDeckDataStatus",
        "summary": "Consultar data disponible",
        "tags": [
          "Data ZIP"
        ],
        "description": "Requiere ZipArchive en el servidor. Las fuentes y el inventario se verifican sin cambiar cantidades de cartas. Devuelve token, existencia de data y conteos.",
