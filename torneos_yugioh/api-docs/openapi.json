{
  "openapi": "3.0.3",
  "info": {
    "title": "Station X · API de Decks",
    "version": "1.0.1",
    "description": "Operaciones implementadas mediante adaptadores a los controladores nativos. Los 37 endpoints REST propuestos todavía no están implementados. El CRUD de datos generales del deck sigue en formularios y no se anuncia como API REST. Las lecturas con token deben ejecutarse primero; Swagger reutiliza esos tokens solo en memoria y mantiene las cookies del mismo origen."
  },
  "servers": [
    {
      "url": "../api/index.php",
      "description": "Misma plataforma y sesión que esta documentación"
    }
  ],
  "tags": [
    {
      "name": "Decklist"
    },
    {
      "name": "Catálogo de cartas"
    },
    {
      "name": "Combos"
    },
    {
      "name": "Mundos"
    },
    {
      "name": "Data ZIP"
    }
  ],
  "paths": {
    "/decklist": {
      "get": {
        "operationId": "getDecklist",
        "summary": "Consultar lista y versión",
        "tags": [
          "Decklist"
        ],
        "description": "Devuelve cartas guardadas, versión y token. Ejecuta esta lectura antes de guardar.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "query",
            "required": true,
            "description": "ID real del deck en la plataforma.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecklistSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Datos no válidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Operación no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "saveDecklist",
        "summary": "Guardar lista completa",
        "tags": [
          "Decklist"
        ],
        "description": "Reemplaza la lista completa. Para agregar, quitar o mover cartas envía el arreglo final y la versión del GET. Mantiene bloqueo, transacción y auditoría. El token va en el JSON; no en X-CSRF-Token. Una versión obsoleta responde 422 en el contrato nativo.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "query",
            "required": true,
            "description": "ID real del deck en la plataforma.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "422": {
            "description": "Datos no válidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Operación no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecklistSave"
              }
            }
          }
        }
      }
    },
    "/cards/search": {
      "get": {
        "operationId": "searchCards",
        "summary": "Buscar cartas del catálogo",
        "tags": [
          "Catálogo de cartas"
        ],
        "description": "Consulta el proveedor/caché utilizado por el editor. No modifica inventarios.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Nombre o código de carta.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Filtro nativo del catálogo; all para todos.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Índice de página; comienza en 0.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "422": {
            "description": "Datos no válidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Operación no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/cards/detail": {
      "get": {
        "operationId": "getCard",
        "summary": "Consultar efecto e imagen de una carta",
        "tags": [
          "Catálogo de cartas"
        ],
        "description": "local=1 consulta solo caché local; local=0 permite proveedor. No fabrica efectos ni traduce el texto original.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "ID YGOPRODeck, no CID de Konami.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "local",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ],
              "default": "1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "422": {
            "description": "Datos no válidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Operación no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/cards/image": {
      "get": {
        "operationId": "getCardImage",
        "summary": "Obtener fotografía de carta",
        "tags": [
          "Catálogo de cartas"
        ],
        "description": "Solo acepta IDs catalogados; full sirve el original grande.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "ID YGOPRODeck, no CID de Konami.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string",
              "enum": [
                "small",
                "full"
              ],
              "default": "full"
            }
          },
          {
            "name": "local",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ],
              "default": "0"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Datos no válidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Operación no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/combos": {
      "get": {
        "operationId": "getDeckCombos",
        "summary": "Consultar combos, inventario e historial",
        "tags": [
          "Combos"
        ],
        "description": "Sin history devuelve las creaciones del deck. Con history devuelve también revisiones del combo indicado. Incluye token de sesión.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "query",
            "required": true,
            "description": "ID real del deck en la plataforma.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "history",
            "in": "query",
            "required": false,
            "description": "ID del combo cuyo historial se desea consultar.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "422": {
            "description": "Datos no válidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
