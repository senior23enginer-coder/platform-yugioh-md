            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/deck-data/export": {
      "get": {
        "operationId": "exportDeckData",
        "summary": "Exportar carpeta del deck en ZIP",
        "tags": [
          "Data ZIP"
        ],
        "description": "Requiere ZipArchive en el servidor. Las fuentes y el inventario se verifican sin cambiar cantidades de cartas. Incluye la carpeta individual y stationx-deck.json para la importación posterior.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "query",
            "required": true,
            "description": "ID real del deck en la plataforma.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Datos no válidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Operación no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/deck-data/preview": {
      "post": {
        "operationId": "previewDeckData",
        "summary": "Preparar importación ZIP",
        "tags": [
          "Data ZIP"
        ],
        "description": "Requiere ZipArchive en el servidor. Las fuentes y el inventario se verifican sin cambiar cantidades de cartas. Máximo 48 MiB. No publica: devuelve ticket y diferencias. Conserva revisiones nativas del editor.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "query",
            "required": true,
            "description": "ID real del deck en la plataforma.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Versión o inventario cambió.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Datos no válidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Operación no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "package": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "package"
                ]
              }
            }
          }
        },
        "security": [
          {
            "sessionCsrf": []
          }
        ]
      }
    },
    "/deck-data/commit": {
      "post": {
        "operationId": "commitDeckData",
        "summary": "Confirmar importación preparada",
        "tags": [
          "Data ZIP"
        ],
        "description": "Aplica el ticket de preview en la misma sesión, con vigencia de 30 minutos. Rechaza cambios concurrentes y conserva inventario e historial.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "query",
            "required": true,
            "description": "ID real del deck en la plataforma.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Versión o inventario cambió.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Datos no válidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Operación no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "ticket": {
                    "type": "string"
                  }
                },
                "required": [
                  "ticket"
                ]
              }
            }
          }
        },
        "security": [
          {
            "sessionCsrf": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "message"
        ]
      },
      "CardRow": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "enum": [
              "main",
              "extra",
              "side",
              "reserve"
            ]
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "existing_id": {
            "type": "integer",
            "minimum": 0
          },
          "card_id": {
            "type": "integer",
            "minimum": 0
          },
          "card_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "merged_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "section",
          "quantity"
        ]
      },
      "DecklistSave": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "cards": {
            "type": "array",
            "maxItems": 300,
            "items": {
              "$ref": "#/components/schemas/CardRow"
            }
          },
          "documented_import": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "token",
          "version",
          "cards"
        ]
      },
      "DecklistSnapshot": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "token": {
            "type": "string"
          },
          "can_edit": {
            "type": "boolean"
          },
          "deck": {
            "type": "object",
            "additionalProperties": true
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ComboNode": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "opening",
              "step",
              "decision",
              "result"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "action": {
            "type": "string",
            "maxLength": 80
          },
          "explanation": {
            "type": "string",
            "maxLength": 4000
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 5000
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 5000
          },
          "cards": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "x",
          "y"
        ]
      },
      "ComboDocument": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{16,64}$"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "combo",
              "strategy"
            ]
          },
          "turn_order": {
            "type": "string",
            "enum": [
              "any",
              "first",
              "second"
            ]
          },
          "board_format": {
            "type": "string",
            "enum": [
              "unspecified",
              "tcg",
              "rush",
              "goat"
            ]
          },
          "editorial_status": {
            "type": "string",
            "enum": [
              "draft",
              "conditional",
              "pending",
              "not_executable"
            ]
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "items": {
              "$ref": "#/components/schemas/ComboNode"
            }
          },
          "edges": {
            "type": "array",
            "maxItems": 120,
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "nodes",
          "edges"
        ]
      },
      "ComboSave": {
        "type": "object",
        "properties": {
          "deck_id": {
            "type": "integer",
            "minimum": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "inventory_sha256": {
            "type": "string"
          },
          "document": {
            "$ref": "#/components/schemas/ComboDocument"
          }
        },
        "required": [
          "deck_id",
          "revision",
          "inventory_sha256",
          "document"
        ]
      },
      "WorldsSave": {
        "type": "object",
        "properties": {
          "deck_id": {
            "type": "integer",
            "minimum": 1
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "attributes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "dark",
                "earth",
                "light",
                "water",
                "wind",
                "fire"
              ]
            }
          }
        },
        "required": [
          "deck_id",
          "expected_revision",
          "attributes"
        ]
      }
    },
    "securitySchemes": {
      "sessionCsrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Token CSRF de la sesi?n existente. Ejecuta primero GET /combos, GET /worlds o GET /deck-data/status: Swagger lo toma autom?ticamente. Tambi?n puedes introducirlo en Authorize. No sustituye los permisos de la plataforma."
      }
    }
  }
}
