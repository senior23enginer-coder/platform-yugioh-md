{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Station X editorial update v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "update_id",
    "base_revision",
    "base_source_sha256",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "const": "station-x-editorial/1"
    },
    "update_id": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "string",
      "pattern": "^sx-[0-9a-f]{20}$"
    },
    "base_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "id",
          "previous_sha256",
          "deck_ids",
          "section",
          "reason",
          "text"
        ],
        "properties": {
          "op": {
            "enum": [
              "add",
              "replace"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "previous_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "deck_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "section": {
            "enum": [
              "cards",
              "combos",
              "consistency",
              "construction",
              "evaluation",
              "identity",
              "interruptions",
              "matchups",
              "plan",
              "practice",
              "reference",
              "turn_order"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "after_id": {
            "type": "string",
            "minLength": 1
          },
          "visual": {
            "type": "object",
            "properties": {
              "list_bindings": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[0-9]+$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "op": {
                  "const": "add"
                }
              }
            },
            "then": {
              "required": [
                "title",
                "after_id"
              ],
              "properties": {
                "previous_sha256": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "previous_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        ]
      }
    }
  }
}
